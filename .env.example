# copy to .env and fill in. .env is gitignored.

# --- dagster postgres -------------------------------------------------------
DAGSTER_POSTGRES_USER=dagster
DAGSTER_POSTGRES_PASSWORD=dagster
DAGSTER_POSTGRES_DB=dagster

# --- minio ------------------------------------------------------------------
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio12345

# --- grafana ----------------------------------------------------------------
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# --- llm providers (phase 2) ------------------------------------------------
# Only the default provider's key is required; others are optional.
SENTINEL_LLM_PROVIDER=groq
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- duckdb -----------------------------------------------------------------
# host-side path; the container overrides this internally
DUCKDB_PATH=./data/warehouse/sentinel.duckdb
